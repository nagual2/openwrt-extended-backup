{
  "plugins": {
    "Base64HighEntropyString": {
      "limit": 4.5
    },
    "HexHighEntropyString": {
      "limit": 3.0
    },
    "KeywordDetector": {},
    "RegexDetector": {
      "denylist": [
        {
          "name": "AWS Access Key ID",
          "description": "Potential AWS Access Key ID",
          "pattern": "AKIA[0-9A-Z]{16}"
        },
        {
          "name": "AWS Secret Key",
          "description": "Potential AWS Secret Access Key",
          "pattern": "(?i)aws(.{0,20})?(secret|access)?(.{0,20})?(key|token)\\s*[:=]\\s*['\\\"]?[0-9a-zA-Z/+]{40}['\\\"]?"
        },
        {
          "name": "GitHub Token",
          "description": "Potential GitHub Personal Access Token",
          "pattern": "gh[pousr]_[0-9a-zA-Z]{36}"
        },
        {
          "name": "Generic API Key",
          "description": "Generic API key pattern",
          "pattern": "(?i)(api|token|secret|key)[-_]?(id|key|token|secret)?\\s*[:=]\\s*['\\\"]?[0-9a-zA-Z]{16,45}['\\\"]?"
        },
        {
          "name": "Database Connection String",
          "description": "Potential database connection string",
          "pattern": "(?i)(postgres|mysql|mongodb|redis|mssql|oracle):/{2}[^\\s@]+:[^\\s@]+@"
        },
        {
          "name": "SSH Private Key",
          "description": "Potential SSH private key block",
          "pattern": "-----BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE KEY-----"
        },
        {
          "name": "TLS Certificate",
          "description": "Potential TLS certificate block",
          "pattern": "-----BEGIN CERTIFICATE-----"
        },
        {
          "name": "Email Address",
          "description": "Possible email address (PII)",
          "pattern": "[A-Z0-9._%+-]+@[A-Z0-9.-]+\\\\.[A-Z]{2,}"
        },
        {
          "name": "Phone Number",
          "description": "Possible phone number (PII)",
          "pattern": "(?:(?:\\\\+?\\\\d{1,3})?[\\\\s-]?)?(?:\\\\(\\\\d{3}\\\\)|\\\\d{3})[\\\\s-]?\\\\d{3}[\\\\s-]?\\\\d{4}"
        },
        {
          "name": "IPv4 Address",
          "description": "Possible IPv4 address",
          "pattern": "\\\\b(?:(?:25[0-5]|2[0-4]\\\\d|[01]?\\\\d\\\\d?)\\\\.){3}(?:25[0-5]|2[0-4]\\\\d|[01]?\\\\d\\\\d?)\\\\b"
        },
        {
          "name": "Internal URL",
          "description": "Possible internal URL",
          "pattern": "https?://(?:(?:10|127|192\\\\.168|172\\\\.(?:1[6-9]|2\\\\d|3[01]))(?:\\\\.\\\\d{1,3}){2}|localhost)[^\\\\s]*"
        },
        {
          "name": "Commented Credential",
          "description": "Potential credential stored in comments",
          "pattern": "#\\\\s*(?:password|passwd|pwd|secret)\\\\s*[:=]\\\\s*[^\\\\s]+"
        }
      ]
    }
  },
  "filters": {
    "allowlist": {
      "commonly_ignored_files": true,
      "known_secret": [],
      "regex": []
    },
    "regex": []
  }
}